{
  "name": "dsh-session-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight session-status HUD for DeepSeek Harness: lists live sessions with color-coded state (running / awaiting you / done / idle), updates in real time, notifies when a session finishes or needs attention, and can detach into an OS-level always-on-top window that survives minimizing the DSH app. Clicking a row jumps to that session's conversation. · 轻量会话状态悬浮面板：实时列出各会话并以颜色区分状态（运行中/待处理/已完成/空闲），必要时系统通知，可外置为不随 DSH 最小化的置顶小窗，点击行跳转对应会话。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/client.test.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "session-monitor",
    "status",
    "picture-in-picture",
    "notification"
  ],
  "license": "MIT"
}
